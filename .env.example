# Copy to .env (git-ignored) and replace every change-me value. Never commit .env.
# Names match docs/deployment.md §5.1.

# Postgres (compose.yaml)
DB_URL=jdbc:postgresql://localhost:5432/invoice_intel
DB_USER=invoice_intel
DB_PASSWORD=change-me

# S3-compatible storage (SeaweedFS locally, ADR-11). Keys: letters and digits only
# (compose.yaml writes them into a JSON identity file).
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
S3_BUCKET_RAW=raw
S3_BUCKET_REDACTED=redacted
